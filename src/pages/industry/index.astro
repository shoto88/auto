---
import Base from '../../layouts/Base.astro';

const industries = [
  {
    name: '小売・スーパー・コンビニ',
    points: [
      'レジ・サービスカウンターでの暴言・威嚇が典型。パート・アルバイトが最初に直面するため、交代基準(誰を呼ぶか)を明文化しておく',
      '店頭掲示(短縮版の方針)による抑止が有効。レジ横・サービスカウンターに掲示',
      '防犯カメラの映像保存ルールを対応記録として位置づける',
    ],
  },
  {
    name: '飲食店',
    points: [
      '席での長時間の叱責・居座り・過度な作り直し要求が典型。対応時間の上限と「お代は結構ですのでお引き取りください」の判断基準を決めておく',
      '深夜帯は単独勤務を避ける、通報手段(インカム・ボタン)を用意する',
      '予約サイト・Googleレビューでの脅迫(「書き込むぞ」)への対応方針も明記する',
    ],
  },
  {
    name: '介護・医療',
    points: [
      '利用者・患者本人だけでなく家族からのハラスメントが多いのが特徴。契約時に重要事項説明書へカスハラ対応方針を盛り込む',
      '訪問系は単独業務のため、ウェアラブル録音・緊急通報ツールの導入効果が大きい',
      'ケアの拒否と正当なクレームの線引きを、事業所として文書化しておく',
    ],
  },
  {
    name: 'コールセンター・カスタマーサポート',
    points: [
      '全通話録音+冒頭アナウンスが基本。アナウンス自体に抑止効果がある',
      '通話時間・コール回数の上限、切電(通話終了)の許可基準をスクリプト化する',
      'オペレーターの離席・交代をためらわせない評価制度(切電をマイナス評価にしない)が定着の鍵',
    ],
  },
  {
    name: '自治体・公共窓口',
    points: [
      '「住民対応だから断れない」という思い込みが被害を長期化させる。対応打ち切り基準を要綱として整備する',
      '窓口への掲示と、複数名対応・記録の徹底が基本',
      '議員・有力者経由の圧力もカスハラになり得ることを組織として確認しておく',
    ],
  },
  {
    name: '不動産・住宅',
    points: [
      '入居者・施主からの深夜連絡、過度な補修要求、SNS晒しの脅しが典型',
      '緊急連絡先と通常窓口を分離し、営業担当個人の携帯で受けない体制にする',
      '契約書・重要事項説明にカスハラ対応方針を明記して入口で抑止する',
    ],
  },
];
---
<Base
  title="業種別カスハラ対策の要点|小売・飲食・介護・コールセンター・自治体・不動産"
  description="カスタマーハラスメント対策の要点を業種別に整理。小売・飲食・介護・コールセンター・自治体・不動産それぞれの典型パターンと、現場で機能する対策のポイントをまとめました。"
>
  <p><a href="/">← トップに戻る</a></p>
  <h1>業種別カスハラ対策の要点</h1>
  <p>
    カスハラの起き方は業種によって大きく異なります。義務化対応(<a href="/guide/">共通の4ステップ</a>)を押さえたうえで、自社の業種の典型パターンに合わせて方針とフローを調整してください。
  </p>

  {industries.map((ind) => (
    <>
      <h2>{ind.name}</h2>
      <div class="card">
        <ul>
          {ind.points.map((p) => <li>{p}</li>)}
        </ul>
      </div>
    </>
  ))}

  <h2>次のステップ</h2>
  <div class="card">
    <p>
      業種別の「対象となる行為」を<a href="/templates/">基本方針のひな形</a>に反映し、体制が足りない部分は<a href="/services/">外部サービス</a>で補完してください。
    </p>
  </div>
</Base>
